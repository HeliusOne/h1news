{
  "name": "H1 News → Slack (watchlist headlines)",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [ { "field": "minutes", "minutesInterval": 5 } ] } },
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [ 0, 0 ]
    },
    {
      "parameters": {
        "jsCode": "// One item per watchlist symbol. Basic plan = one ticker per call; Pro can\n// pass them all at once (ticker=AAPL,TSLA,NVDA) and skip the fan-out.\nconst watchlist = ($env.H1NEWS_WATCHLIST || 'AAPL,TSLA,NVDA').split(',').map(s => s.trim().toUpperCase());\nconst state = $getWorkflowStaticData('global');\nreturn watchlist.map(ticker => ({ json: { ticker, since_id: state[`since_${ticker}`] || 0 } }));"
      },
      "name": "Watchlist",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ 220, 0 ]
    },
    {
      "parameters": {
        "url": "=https://api.heliusone.com/v1/news?ticker={{ $json.ticker }}&since_id={{ $json.since_id }}&sort=oldest&limit=20",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "name": "GET /v1/news",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 440, 0 ],
      "credentials": { "httpHeaderAuth": { "id": "REPLACE_ME", "name": "H1 News API key (X-API-Key)" } }
    },
    {
      "parameters": {
        "jsCode": "// Flatten pages into one item per NEW article and remember the high-water mark\n// per ticker, so the next run only sees what arrived since.\nconst state = $getWorkflowStaticData('global');\nconst out = [];\nfor (const page of $input.all()) {\n  for (const a of page.json.results || []) {\n    for (const t of (a.tickers || [])) {\n      state[`since_${t}`] = Math.max(state[`since_${t}`] || 0, a.id);\n    }\n    out.push({ json: a });\n  }\n}\nreturn out;"
      },
      "name": "New articles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ 660, 0 ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": { "__rl": true, "mode": "name", "value": "#market-news" },
        "text": "={{ ({positive:'🟢',negative:'🔴'}[$json.sentiment.label] || '⚪') }} *{{ $json.tickers.join(', ') }}* — <{{ $json.url }}|{{ $json.title.replace(/[<>]/g,'') }}>\n_{{ $json.source }} · {{ $json.category }} · {{ $json.published_at.slice(0,16).replace('T',' ') }} UTC_",
        "otherOptions": { "mrkdwn": true }
      },
      "name": "Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [ 880, 0 ],
      "credentials": { "slackApi": { "id": "REPLACE_ME", "name": "Slack" } }
    }
  ],
  "connections": {
    "Every 5 minutes": { "main": [ [ { "node": "Watchlist", "type": "main", "index": 0 } ] ] },
    "Watchlist": { "main": [ [ { "node": "GET /v1/news", "type": "main", "index": 0 } ] ] },
    "GET /v1/news": { "main": [ [ { "node": "New articles", "type": "main", "index": 0 } ] ] },
    "New articles": { "main": [ [ { "node": "Slack", "type": "main", "index": 0 } ] ] }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCredsSetupCompleted": false }
}
